# Copy to .env.local for local development, and set the same values in Vercel
# (Project Settings, Environment Variables) for Preview and Production.
# Without RESEND_API_KEY the forms fail loudly rather than pretending to send.

# Resend API key, from resend.com, API Keys, with sending permission.
RESEND_API_KEY=

# Sender address. Leave unset to use Resend's shared sender, which needs no DNS
# but only delivers to the Resend account's own address, so requests reach us and
# requesters get no acknowledgement. Set it once a domain is verified in Resend.
# Replies go to admin@refittr.co.uk either way.
EMAIL_FROM="Take a Seat <hello@send.refittr.co.uk>"
